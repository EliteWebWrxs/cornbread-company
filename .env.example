# SMTP credentials for the catering/contact inquiry form.
# Copy to .env and fill in. .env is gitignored — never commit real values.

# The Gmail address that sends and receives inquiries.
GOOGLE_EMAIL=you@example.com

# A Google App Password, NOT the account password. Requires 2-Step Verification:
# https://myaccount.google.com/apppasswords
GOOGLE_EMAIL_PASSWORD=

# smtp.gmail.com — port 465 (implicit TLS) or 587 (STARTTLS)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=465
